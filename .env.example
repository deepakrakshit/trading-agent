# Offline mode is the safe default. This project never submits broker orders.
DATA_MODE=synthetic
PAPER_ACCOUNT_ID=offline-demo
READ_ONLY_PROVIDER=none
# Provider-specific read-only credentials may be added locally later; never commit .env.
# Obtain sessions locally through the official provider; this app does not log in.
# Only read-only market-data endpoints are present in this project.
SMARTAPI_API_KEY=
SMARTAPI_TOKEN=
